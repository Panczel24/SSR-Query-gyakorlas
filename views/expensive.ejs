<%- include('partials/header.ejs')  %>


<br><br>

    <form action="/expensive" method="get">
        <label for="amount">Összeg</label>
        <input type="number" id="amount" name="amount" value="<%= amount %>">
        <button type="submit">Drága</button>
    </form>

    <% if (expense.length===0) { %>

        <p>Nincs találat</p>

        <% } else { %>

            <table>
                <thead>
                    <tr>
                        <th>Megnevezés</th>
                        <th>Összeg</th>
                        <th>Kategória</th>
                    </tr>
                </thead>

                <tbody>
                    <% expense.forEach(expense=> { %>
                        <tr class="<%= expense.category %>">
                            <td>
                                <%= expense.name %>
                            </td>
                            <td>
                                <%= expense.amount %>
                            </td>
                            <td>
                                <%= expense.category %>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>

            <% } %>
</body>

</html>
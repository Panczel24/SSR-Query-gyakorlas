<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>

    <link rel="stylesheet" href="/style.css">

</head>

<body>
    <h1>
        <%= title %>
    </h1>

    <a href="/">Főoldal</a>
    <a href="/all">Összes</a>
    <a href="/top3">Top3</a>
    <a href="/search">Search</a>
    <a href="/expensive">expensive</a>
    <a href="/stats">stats</a>

    <h2>Keresés</h2>
    <form action="/search" method="get">
        <label for="name">Keresés név alapján</label>
        <input type="text" id="name" name="name" value="<%= searchTerm %>">
        <button type="submit">Keresés</button>
    </form>

    <% if (expense.length===0) { %>

        <p>Nincs találat</p>

        <% } else { %>

            <table>
                <thead>
                    <tr>
                        <th>Megnevezés</th>
                        <th>Összeg</th>
                        <th>Kategória</th>
                    </tr>
                </thead>

                <tbody>
                    <% expense.forEach(expense=> { %>
                        <tr class="<%= expense.category %>">
                            <td>
                                <%= expense.name %>
                            </td>
                            <td>
                                <%= expense.amount %>
                            </td>
                            <td>
                                <%= expense.category %>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>

            <% } %>
</body>

</html>
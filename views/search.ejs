<%- include('partials/header.ejs')  %>


    <h2>Keresés</h2>
    <form action="/search" method="get">
        <label for="name">Keresés név alapján</label>
        <input type="text" id="name" name="name" value="<%= searchTerm %>">
        <button type="submit">Keresés</button>
    </form>

    <% if (expense.length===0) { %>

        <p>Nincs találat</p>

        <% } else { %>

            <table>
                <thead>
                    <tr>
                        <th>Megnevezés</th>
                        <th>Összeg</th>
                        <th>Kategória</th>
                    </tr>
                </thead>

                <tbody>
                    <% expense.forEach(expense=> { %>
                        <tr class="<%= expense.category %>">
                            <td>
                                <%= expense.name %>
                            </td>
                            <td>
                                <%= expense.amount %>
                            </td>
                            <td>
                                <%= expense.category %>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>

            <% } %>
</body>

</html>
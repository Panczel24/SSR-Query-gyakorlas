<%- include('partials/header.ejs')  %>


    <h2>Költések</h2>

    <table>
        <thead>
            <tr>
                <th>Megnevezés</th>
                <th>Összeg</th>
                <th>Kategória</th>
            </tr>
        </thead>

        <tbody>
            <% expense.forEach(expense=> { %>
                <tr class="<%= expense.category %>">
                    <td>
                        <%= expense.name %>
                    </td>
                    <td>
                        <%= expense.amount %>
                    </td>
                    <td>
                        <%= expense.category %>
                    </td>
                </tr>
                <% }); %>
        </tbody>
    </table>

</body>

</html>